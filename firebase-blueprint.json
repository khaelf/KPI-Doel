{
  "entities": {
    "workEntry": {
      "title": "WorkEntry",
      "description": "Daily work log record for Humas and IT departments at Pesantren Parabek",
      "type": "object",
      "properties": {
        "tanggalMasuk": {
          "type": "string",
          "description": "Date request received in YYYY-MM-DD"
        },
        "tanggalMulai": {
          "type": "string",
          "description": "Date work started in YYYY-MM-DD"
        },
        "tanggalSelesai": {
          "type": "string",
          "description": "Date work completed in YYYY-MM-DD"
        },
        "jamMulai": {
          "type": "string",
          "description": "Work start time HH:mm"
        },
        "jamSelesai": {
          "type": "string",
          "description": "Work end time HH:mm"
        },
        "lokasi": {
          "type": "string",
          "maxLength": 300
        },
        "jumlahRevisi": {
          "type": "integer",
          "description": "Number of revisions"
        },
        "bidang": {
          "type": "string",
          "enum": ["Humas", "IT"]
        },
        "namaPekerjaan": {
          "type": "string",
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "enum": ["Belum dikerjakan", "Proses", "Selesai"]
        },
        "persentase": {
          "type": "integer"
        },
        "catatan": {
          "type": "string",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["tanggalMasuk", "bidang", "namaPekerjaan", "status", "persentase"]
    },
    "kpiIndicator": {
      "title": "KpiIndicator",
      "description": "Monthly KPI target and achievement indicator",
      "type": "object",
      "properties": {
        "bidang": {
          "type": "string",
          "enum": ["Humas", "IT"]
        },
        "namaIndikator": {
          "type": "string",
          "maxLength": 500
        },
        "satuan": {
          "type": "string",
          "maxLength": 100
        },
        "target": {
          "type": "number"
        },
        "realisasi": {
          "type": "number"
        },
        "bobot": {
          "type": "number"
        },
        "periodeBulan": {
          "type": "string"
        }
      },
      "required": ["bidang", "namaIndikator", "satuan", "target", "realisasi", "bobot", "periodeBulan"]
    },
    "agendaItem": {
      "title": "AgendaItem",
      "description": "Event and agenda schedule item for Humas and IT",
      "type": "object",
      "properties": {
        "judul": {
          "type": "string",
          "maxLength": 500
        },
        "jenisJadwal": {
          "type": "string",
          "enum": ["1hari", "rentang"]
        },
        "tanggal": {
          "type": "string",
          "description": "Start date in YYYY-MM-DD"
        },
        "tanggalSelesaiAgenda": {
          "type": "string",
          "description": "End date in YYYY-MM-DD"
        },
        "waktuMulai": {
          "type": "string"
        },
        "waktuSelesai": {
          "type": "string"
        },
        "lokasi": {
          "type": "string",
          "maxLength": 500
        },
        "bidang": {
          "type": "string",
          "enum": ["Humas", "IT", "Semua"]
        },
        "penanggungJawab": {
          "type": "string",
          "maxLength": 200
        },
        "keterangan": {
          "type": "string",
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "enum": ["Mendatang", "Berlangsung", "Selesai", "Dibatalkan"]
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["judul", "tanggal", "bidang", "status"]
    }
  },
  "firestore": {
    "/workEntries/{entryId}": {
      "schema": "workEntry",
      "description": "Daily work entries for Parabek Humas & IT"
    },
    "/kpiIndicators/{indicatorId}": {
      "schema": "kpiIndicator",
      "description": "Monthly KPI performance indicators"
    },
    "/agendaItems/{agendaId}": {
      "schema": "agendaItem",
      "description": "Agenda and activity schedules for Parabek Humas & IT"
    }
  }
}

