rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Work Entries collection rules
    match /workEntries/{entryId} {
      allow read, write: if true;
    }

    // KPI Indicators collection rules
    match /kpiIndicators/{indicatorId} {
      allow read, write: if true;
    }

    // Agenda Items collection rules
    match /agendaItems/{agendaId} {
      allow read, write: if true;
    }
  }
}

